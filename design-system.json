{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Truegle Design System",
  "version": "2.0.0",
  "description": "Production-ready design system for Truegle AI Search Engine. Complements protected animations, logo, and brand colors.",
  "lastUpdated": "2025-12-29",

  "constraints": {
    "protected": {
      "description": "Elements that MUST NOT be modified by this design system",
      "elements": [
        "Background animations (Galaxy, Iridescence, Particles, Aurora)",
        "TruegleLogo component (design, sizing rules, colors)",
        "Primary brand colors used in animations (cyan glows, purple gradients)",
        "Animation timing and behavior patterns in background components"
      ]
    },
    "extends": {
      "description": "This design system EXTENDS and COMPLEMENTS the protected elements",
      "purpose": "Provide consistent styling for UI components, typography, and layout"
    }
  },

  "spacing": {
    "description": "8px base unit spacing scale for consistent rhythm",
    "baseUnit": 8,
    "scale": {
      "0": "0px",
      "px": "1px",
      "0.5": "4px",
      "1": "8px",
      "1.5": "12px",
      "2": "16px",
      "2.5": "20px",
      "3": "24px",
      "3.5": "28px",
      "4": "32px",
      "5": "40px",
      "6": "48px",
      "7": "56px",
      "8": "64px",
      "9": "72px",
      "10": "80px",
      "11": "88px",
      "12": "96px",
      "14": "112px",
      "16": "128px",
      "20": "160px",
      "24": "192px",
      "28": "224px",
      "32": "256px"
    },
    "semantic": {
      "componentPadding": {
        "xs": { "value": "8px", "tailwind": "p-2" },
        "sm": { "value": "12px", "tailwind": "p-3" },
        "md": { "value": "16px", "tailwind": "p-4" },
        "lg": { "value": "24px", "tailwind": "p-6" },
        "xl": { "value": "32px", "tailwind": "p-8" }
      },
      "sectionGap": {
        "tight": { "value": "16px", "tailwind": "gap-4" },
        "default": { "value": "24px", "tailwind": "gap-6" },
        "loose": { "value": "48px", "tailwind": "gap-12" },
        "spacious": { "value": "64px", "tailwind": "gap-16" }
      },
      "inlineGap": {
        "tight": { "value": "4px", "tailwind": "gap-1" },
        "default": { "value": "8px", "tailwind": "gap-2" },
        "loose": { "value": "12px", "tailwind": "gap-3" }
      },
      "stackGap": {
        "tight": { "value": "8px", "tailwind": "space-y-2" },
        "default": { "value": "16px", "tailwind": "space-y-4" },
        "loose": { "value": "24px", "tailwind": "space-y-6" }
      }
    },
    "responsive": {
      "containerPadding": {
        "mobile": { "value": "16px", "tailwind": "px-4" },
        "tablet": { "value": "24px", "tailwind": "sm:px-6" },
        "desktop": { "value": "32px", "tailwind": "lg:px-8" }
      },
      "modalPadding": {
        "mobile": { "value": "16px", "tailwind": "p-4" },
        "tablet": { "value": "24px", "tailwind": "sm:p-6" },
        "desktop": { "value": "32px", "tailwind": "md:p-8" }
      },
      "sectionPadding": {
        "mobile": { "value": "32px", "tailwind": "py-8" },
        "tablet": { "value": "64px", "tailwind": "sm:py-16" },
        "desktop": { "value": "96px", "tailwind": "lg:py-24" }
      }
    }
  },

  "typography": {
    "description": "Typography scale optimized for readability on dark backgrounds",

    "fontFamilies": {
      "sans": {
        "value": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
        "usage": "Primary font for all UI text",
        "tailwindKey": "font-sans"
      },
      "mono": {
        "value": "'SF Mono', 'Fira Code', 'Consolas', 'Monaco', monospace",
        "usage": "Code snippets, technical data, search queries",
        "tailwindKey": "font-mono"
      },
      "display": {
        "value": "'Inter', -apple-system, BlinkMacSystemFont, sans-serif",
        "usage": "Hero headlines, marketing text (requires Inter font)",
        "tailwindKey": "font-display"
      }
    },

    "fontWeights": {
      "thin": { "value": 100, "tailwind": "font-thin" },
      "light": { "value": 300, "tailwind": "font-light" },
      "regular": { "value": 400, "tailwind": "font-normal" },
      "medium": { "value": 500, "tailwind": "font-medium" },
      "semibold": { "value": 600, "tailwind": "font-semibold" },
      "bold": { "value": 700, "tailwind": "font-bold" },
      "extrabold": { "value": 800, "tailwind": "font-extrabold" },
      "black": { "value": 900, "tailwind": "font-black" }
    },

    "scale": {
      "h1": {
        "fontSize": "48px",
        "lineHeight": "56px",
        "fontWeight": 800,
        "letterSpacing": "-0.02em",
        "tailwind": "text-5xl font-extrabold tracking-tight leading-tight",
        "responsive": {
          "mobile": {
            "fontSize": "32px",
            "lineHeight": "40px",
            "tailwind": "text-3xl leading-tight"
          },
          "tablet": {
            "fontSize": "40px",
            "lineHeight": "48px",
            "tailwind": "sm:text-4xl"
          },
          "desktop": {
            "fontSize": "48px",
            "lineHeight": "56px",
            "tailwind": "lg:text-5xl"
          }
        },
        "usage": "Page titles, hero headlines"
      },
      "h2": {
        "fontSize": "36px",
        "lineHeight": "44px",
        "fontWeight": 700,
        "letterSpacing": "-0.01em",
        "tailwind": "text-4xl font-bold tracking-tight",
        "responsive": {
          "mobile": { "fontSize": "24px", "lineHeight": "32px", "tailwind": "text-2xl" },
          "tablet": { "fontSize": "30px", "lineHeight": "38px", "tailwind": "sm:text-3xl" },
          "desktop": { "fontSize": "36px", "lineHeight": "44px", "tailwind": "lg:text-4xl" }
        },
        "usage": "Section titles, major headings"
      },
      "h3": {
        "fontSize": "28px",
        "lineHeight": "36px",
        "fontWeight": 600,
        "letterSpacing": "-0.005em",
        "tailwind": "text-2xl font-semibold",
        "responsive": {
          "mobile": { "fontSize": "20px", "lineHeight": "28px", "tailwind": "text-xl" },
          "tablet": { "fontSize": "24px", "lineHeight": "32px", "tailwind": "sm:text-2xl" },
          "desktop": { "fontSize": "28px", "lineHeight": "36px", "tailwind": "lg:text-[28px]" }
        },
        "usage": "Subsections, card titles"
      },
      "h4": {
        "fontSize": "22px",
        "lineHeight": "28px",
        "fontWeight": 600,
        "letterSpacing": "0",
        "tailwind": "text-xl font-semibold leading-7",
        "responsive": {
          "mobile": { "fontSize": "18px", "lineHeight": "26px", "tailwind": "text-lg" },
          "desktop": { "fontSize": "22px", "lineHeight": "28px", "tailwind": "lg:text-xl" }
        },
        "usage": "Card headers, dialog titles"
      },
      "h5": {
        "fontSize": "18px",
        "lineHeight": "26px",
        "fontWeight": 600,
        "letterSpacing": "0",
        "tailwind": "text-lg font-semibold leading-relaxed",
        "usage": "Small section headers, list titles"
      },
      "h6": {
        "fontSize": "16px",
        "lineHeight": "24px",
        "fontWeight": 600,
        "letterSpacing": "0.01em",
        "tailwind": "text-base font-semibold tracking-wide",
        "usage": "Minor headings, label headings"
      },
      "body": {
        "large": {
          "fontSize": "18px",
          "lineHeight": "28px",
          "fontWeight": 400,
          "tailwind": "text-lg leading-7",
          "usage": "Lead paragraphs, important body text"
        },
        "default": {
          "fontSize": "16px",
          "lineHeight": "24px",
          "fontWeight": 400,
          "tailwind": "text-base leading-6",
          "usage": "Primary body text"
        },
        "small": {
          "fontSize": "14px",
          "lineHeight": "20px",
          "fontWeight": 400,
          "tailwind": "text-sm leading-5",
          "usage": "Secondary body text, descriptions"
        }
      },
      "caption": {
        "default": {
          "fontSize": "12px",
          "lineHeight": "16px",
          "fontWeight": 400,
          "letterSpacing": "0.02em",
          "tailwind": "text-xs leading-4 tracking-wide",
          "usage": "Image captions, timestamps, metadata"
        },
        "uppercase": {
          "fontSize": "11px",
          "lineHeight": "16px",
          "fontWeight": 600,
          "letterSpacing": "0.08em",
          "textTransform": "uppercase",
          "tailwind": "text-[11px] font-semibold uppercase tracking-widest",
          "usage": "Category labels, badges, overlines"
        }
      },
      "label": {
        "default": {
          "fontSize": "14px",
          "lineHeight": "20px",
          "fontWeight": 500,
          "tailwind": "text-sm font-medium",
          "usage": "Form labels, navigation items"
        },
        "small": {
          "fontSize": "12px",
          "lineHeight": "16px",
          "fontWeight": 500,
          "tailwind": "text-xs font-medium",
          "usage": "Small labels, helper text"
        }
      },
      "button": {
        "xs": {
          "fontSize": "12px",
          "lineHeight": "16px",
          "fontWeight": 600,
          "letterSpacing": "0.02em",
          "tailwind": "text-xs font-semibold tracking-wide"
        },
        "sm": {
          "fontSize": "13px",
          "lineHeight": "18px",
          "fontWeight": 600,
          "tailwind": "text-[13px] font-semibold"
        },
        "md": {
          "fontSize": "14px",
          "lineHeight": "20px",
          "fontWeight": 600,
          "tailwind": "text-sm font-semibold"
        },
        "lg": {
          "fontSize": "16px",
          "lineHeight": "24px",
          "fontWeight": 600,
          "tailwind": "text-base font-semibold"
        }
      },
      "code": {
        "inline": {
          "fontSize": "14px",
          "lineHeight": "20px",
          "fontWeight": 400,
          "fontFamily": "mono",
          "tailwind": "text-sm font-mono"
        },
        "block": {
          "fontSize": "13px",
          "lineHeight": "20px",
          "fontWeight": 400,
          "fontFamily": "mono",
          "tailwind": "text-[13px] font-mono leading-5"
        }
      }
    },

    "accessibility": {
      "minimumBodySize": "14px",
      "minimumTouchTargetText": "16px",
      "minimumContrastRatio": 4.5,
      "minimumLargeTextContrastRatio": 3.0,
      "lineHeightRatio": 1.5
    }
  },

  "colors": {
    "description": "Neutral color palette for backgrounds, surfaces, and text. Does NOT include brand colors.",
    "note": "Brand colors (cyan, purple, emerald for animations) are defined in tailwind.config.js truegle object and MUST NOT be overridden here.",

    "neutral": {
      "description": "Gray scale for backgrounds and structural elements",
      "scale": {
        "0": { "hex": "#FFFFFF", "tailwind": "white" },
        "50": { "hex": "#FAFAFA", "tailwind": "neutral-50" },
        "100": { "hex": "#F4F4F5", "tailwind": "neutral-100" },
        "200": { "hex": "#E4E4E7", "tailwind": "neutral-200" },
        "300": { "hex": "#D4D4D8", "tailwind": "neutral-300" },
        "400": { "hex": "#A1A1AA", "tailwind": "neutral-400" },
        "500": { "hex": "#71717A", "tailwind": "neutral-500" },
        "600": { "hex": "#52525B", "tailwind": "neutral-600" },
        "700": { "hex": "#3F3F46", "tailwind": "neutral-700" },
        "800": { "hex": "#27272A", "tailwind": "neutral-800" },
        "850": { "hex": "#1F1F23", "tailwind": "[#1F1F23]" },
        "900": { "hex": "#18181B", "tailwind": "neutral-900" },
        "925": { "hex": "#121214", "tailwind": "[#121214]" },
        "950": { "hex": "#09090B", "tailwind": "neutral-950" }
      }
    },

    "background": {
      "description": "Semantic background colors for dark theme UI",
      "base": {
        "value": "#09090B",
        "rgba": "rgba(9, 9, 11, 1)",
        "tailwind": "bg-neutral-950",
        "usage": "Main app background (behind animations)"
      },
      "elevated": {
        "value": "#18181B",
        "rgba": "rgba(24, 24, 27, 1)",
        "tailwind": "bg-neutral-900",
        "usage": "Cards, modals, elevated surfaces"
      },
      "surface": {
        "value": "#27272A",
        "rgba": "rgba(39, 39, 42, 1)",
        "tailwind": "bg-neutral-800",
        "usage": "Input fields, secondary containers"
      },
      "sunken": {
        "value": "#121214",
        "rgba": "rgba(18, 18, 20, 1)",
        "tailwind": "bg-[#121214]",
        "usage": "Recessed areas, code blocks"
      },
      "overlay": {
        "light": { "value": "rgba(0, 0, 0, 0.50)", "tailwind": "bg-black/50" },
        "medium": { "value": "rgba(0, 0, 0, 0.70)", "tailwind": "bg-black/70" },
        "heavy": { "value": "rgba(0, 0, 0, 0.80)", "tailwind": "bg-black/80" },
        "usage": "Modal overlays, backdrop"
      },
      "glass": {
        "dark": {
          "value": "rgba(15, 15, 35, 0.95)",
          "tailwind": "bg-[rgba(15,15,35,0.95)]",
          "usage": "Modal containers on animated backgrounds"
        },
        "medium": {
          "value": "rgba(15, 15, 35, 0.85)",
          "tailwind": "bg-[rgba(15,15,35,0.85)]",
          "usage": "Cards on animated backgrounds"
        },
        "light": {
          "value": "rgba(15, 15, 35, 0.70)",
          "tailwind": "bg-[rgba(15,15,35,0.70)]",
          "usage": "Subtle glass effect"
        }
      },
      "whiteAlpha": {
        "5": { "value": "rgba(255, 255, 255, 0.05)", "tailwind": "bg-white/5" },
        "10": { "value": "rgba(255, 255, 255, 0.10)", "tailwind": "bg-white/10" },
        "15": { "value": "rgba(255, 255, 255, 0.15)", "tailwind": "bg-white/[0.15]" },
        "20": { "value": "rgba(255, 255, 255, 0.20)", "tailwind": "bg-white/20" }
      }
    },

    "text": {
      "description": "Text colors for dark theme with WCAG AA compliant contrast ratios",
      "primary": {
        "value": "#FAFAFA",
        "tailwind": "text-neutral-50",
        "contrastOnDark": "15.8:1",
        "usage": "Primary text, headlines, important content"
      },
      "secondary": {
        "value": "#A1A1AA",
        "tailwind": "text-neutral-400",
        "contrastOnDark": "7.2:1",
        "usage": "Secondary text, descriptions, subtitles"
      },
      "tertiary": {
        "value": "#71717A",
        "tailwind": "text-neutral-500",
        "contrastOnDark": "4.6:1",
        "usage": "Placeholder text, less important info"
      },
      "muted": {
        "value": "#52525B",
        "tailwind": "text-neutral-600",
        "contrastOnDark": "3.1:1",
        "usage": "Very subtle text, decorative (use sparingly)"
      },
      "disabled": {
        "value": "#3F3F46",
        "tailwind": "text-neutral-700",
        "usage": "Disabled text states"
      },
      "inverse": {
        "value": "#18181B",
        "tailwind": "text-neutral-900",
        "usage": "Text on light/white backgrounds"
      },
      "onBrand": {
        "value": "#FFFFFF",
        "tailwind": "text-white",
        "usage": "Text on brand-colored backgrounds"
      }
    },

    "border": {
      "description": "Border colors for dark theme",
      "subtle": {
        "value": "rgba(255, 255, 255, 0.05)",
        "tailwind": "border-white/5",
        "usage": "Very subtle dividers, separators"
      },
      "default": {
        "value": "rgba(255, 255, 255, 0.10)",
        "tailwind": "border-white/10",
        "usage": "Default borders on dark surfaces"
      },
      "emphasis": {
        "value": "rgba(255, 255, 255, 0.20)",
        "tailwind": "border-white/20",
        "usage": "Emphasized borders, hover states"
      },
      "strong": {
        "value": "rgba(255, 255, 255, 0.30)",
        "tailwind": "border-white/30",
        "usage": "Strong borders, focus states"
      },
      "solid": {
        "default": { "value": "#3F3F46", "tailwind": "border-neutral-700" },
        "light": { "value": "#52525B", "tailwind": "border-neutral-600" },
        "usage": "Solid borders when opacity not desired"
      }
    },

    "state": {
      "description": "Semantic state colors (functional, not brand colors)",
      "success": {
        "base": { "value": "#22C55E", "tailwind": "text-green-500" },
        "muted": { "value": "rgba(34, 197, 94, 0.15)", "tailwind": "bg-green-500/15" },
        "border": { "value": "rgba(34, 197, 94, 0.30)", "tailwind": "border-green-500/30" }
      },
      "warning": {
        "base": { "value": "#F59E0B", "tailwind": "text-amber-500" },
        "muted": { "value": "rgba(245, 158, 11, 0.15)", "tailwind": "bg-amber-500/15" },
        "border": { "value": "rgba(245, 158, 11, 0.30)", "tailwind": "border-amber-500/30" }
      },
      "error": {
        "base": { "value": "#EF4444", "tailwind": "text-red-500" },
        "muted": { "value": "rgba(239, 68, 68, 0.15)", "tailwind": "bg-red-500/15" },
        "border": { "value": "rgba(239, 68, 68, 0.30)", "tailwind": "border-red-500/30" }
      },
      "info": {
        "base": { "value": "#3B82F6", "tailwind": "text-blue-500" },
        "muted": { "value": "rgba(59, 130, 246, 0.15)", "tailwind": "bg-blue-500/15" },
        "border": { "value": "rgba(59, 130, 246, 0.30)", "tailwind": "border-blue-500/30" }
      }
    }
  },

  "effects": {
    "description": "Visual effects that complement the animated backgrounds",

    "blur": {
      "values": {
        "none": { "value": "0", "tailwind": "backdrop-blur-none" },
        "sm": { "value": "4px", "tailwind": "backdrop-blur-sm" },
        "default": { "value": "8px", "tailwind": "backdrop-blur" },
        "md": { "value": "12px", "tailwind": "backdrop-blur-md" },
        "lg": { "value": "16px", "tailwind": "backdrop-blur-lg" },
        "xl": { "value": "24px", "tailwind": "backdrop-blur-xl" },
        "2xl": { "value": "40px", "tailwind": "backdrop-blur-2xl" },
        "3xl": { "value": "64px", "tailwind": "backdrop-blur-3xl" }
      },
      "recommended": {
        "glass": "backdrop-blur-xl",
        "overlay": "backdrop-blur-sm",
        "modal": "backdrop-blur-xl"
      }
    },

    "shadow": {
