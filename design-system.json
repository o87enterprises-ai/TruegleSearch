  "borderRadius": {
    "description": "Border radius scale for consistent rounded corners",
    "scale": {
      "none": { "value": "0", "tailwind": "rounded-none" },
      "sm": { "value": "4px", "tailwind": "rounded-sm" },
      "default": { "value": "6px", "tailwind": "rounded" },
      "md": { "value": "8px", "tailwind": "rounded-md" },
      "lg": { "value": "12px", "tailwind": "rounded-lg" },
      "xl": { "value": "16px", "tailwind": "rounded-xl" },
      "2xl": { "value": "24px", "tailwind": "rounded-2xl" },
      "3xl": { "value": "32px", "tailwind": "rounded-3xl" },
      "full": { "value": "9999px", "tailwind": "rounded-full" }
    },
    "semantic": {
      "button": { "small": "8px", "default": "12px", "large": "16px" },
      "card": { "default": "16px", "large": "24px" },
      "modal": { "default": "24px" },
      "input": { "default": "12px" },
      "badge": { "default": "6px", "pill": "9999px" },
      "avatar": { "default": "9999px" },
      "tooltip": { "default": "8px" }
    }
  },

  "motion": {
    "description": "Motion timing for micro-interactions. Does NOT affect protected background animations.",
    "note": "Background animation timing is controlled in animation components and must not be modified.",

    "duration": {
      "instant": { "value": "0ms", "tailwind": "duration-0" },
      "fastest": { "value": "75ms", "tailwind": "duration-75" },
      "fast": { "value": "100ms", "tailwind": "duration-100" },
      "normal": { "value": "150ms", "tailwind": "duration-150" },
      "moderate": { "value": "200ms", "tailwind": "duration-200" },
      "relaxed": { "value": "300ms", "tailwind": "duration-300" },
      "slow": { "value": "500ms", "tailwind": "duration-500" },
