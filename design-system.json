      },
      "spring": {
        "value": "cubic-bezier(0.175, 0.885, 0.32, 1.275)",
        "usage": "Playful bouncy effects"
      },
      "bounce": {
        "value": "cubic-bezier(0.68, -0.55, 0.265, 1.55)",
        "usage": "Strong bounce effect"
      },
      "smooth": {
        "value": "cubic-bezier(0.25, 0.1, 0.25, 1)",
        "usage": "Very smooth, premium feel"
      }
    },

    "presets": {
      "description": "Pre-configured motion patterns for common interactions",

      "buttonHover": {
        "duration": "200ms",
        "easing": "easeOut",
        "properties": ["background-color", "border-color", "box-shadow", "transform"],
        "tailwind": "transition-all duration-200 ease-out"
      },
      "buttonPress": {
        "duration": "100ms",
        "easing": "easeIn",
        "transform": "scale(0.98)",
        "tailwind": "active:scale-[0.98] transition-transform duration-100 ease-in"
      },
      "inputFocus": {
        "duration": "200ms",
        "easing": "easeOut",
        "properties": ["border-color", "box-shadow", "background-color"],
        "tailwind": "transition-all duration-200 ease-out"
      },
      "cardHover": {
        "duration": "200ms",
        "easing": "easeOut",
        "transform": "scale(1.02) translateY(-2px)",
        "tailwind": "hover:scale-[1.02] hover:-translate-y-0.5 transition-all duration-200 ease-out"
      },
      "modalOpen": {
        "duration": "300ms",
        "easing": "spring",
        "framerMotion": {
          "initial": { "opacity": 0, "scale": 0.95, "y": 10 },
          "animate": { "opacity": 1, "scale": 1, "y": 0 },
          "exit": { "opacity": 0, "scale": 0.95, "y": 10 },
          "transition": { "duration": 0.3, "ease": [0.175, 0.885, 0.32, 1.275] }
        }
      },
      "modalClose": {
        "duration": "200ms",
        "easing": "easeIn",
        "framerMotion": {
          "exit": { "opacity": 0, "scale": 0.95 },
          "transition": { "duration": 0.2, "ease": "easeIn" }
        }
      },
      "fadeIn": {
        "duration": "300ms",
        "easing": "easeOut",
        "framerMotion": {
          "initial": { "opacity": 0 },
          "animate": { "opacity": 1 },
          "transition": { "duration": 0.3, "ease": "easeOut" }
        },
        "tailwind": "animate-fadeIn"
      },
      "slideUp": {
        "duration": "300ms",
        "easing": "easeOut",
        "framerMotion": {
          "initial": { "opacity": 0, "y": 20 },
          "animate": { "opacity": 1, "y": 0 },
          "transition": { "duration": 0.3, "ease": "easeOut" }
        }
      },
      "slideDown": {
        "duration": "300ms",
        "easing": "easeOut",
        "framerMotion": {
          "initial": { "opacity": 0, "y": -20 },
          "animate": { "opacity": 1, "y": 0 },
          "transition": { "duration": 0.3, "ease": "easeOut" }
        }
      },
      "tooltipShow": {
        "delay": "300ms",
        "duration": "150ms",
        "easing": "easeOut"
      },
      "colorTransition": {
        "duration": "300ms",
        "easing": "easeInOut",
        "tailwind": "transition-colors duration-300 ease-in-out"
      },
      "staggerChildren": {
        "staggerDelay": "50ms",
        "framerMotion": {
          "variants": {
            "container": {
              "animate": { "transition": { "staggerChildren": 0.05 } }
            },
            "item": {
              "initial": { "opacity": 0, "y": 10 },
              "animate": { "opacity": 1, "y": 0 }
            }
          }
        }
      }
    },

    "reducedMotion": {
      "description": "Respect user's reduced motion preference",
      "cssMediaQuery": "@media (prefers-reduced-motion: reduce)",
      "behavior": "Replace animations with instant state changes",
      "tailwind": "motion-reduce:transition-none motion-reduce:transform-none"
    }
