        "tailwind": "ease-in",
        "usage": "Elements leaving the screen"
      },
      "easeOut": {
        "value": "cubic-bezier(0, 0, 0.2, 1)",
        "tailwind": "ease-out",
        "usage": "Elements entering the screen"
