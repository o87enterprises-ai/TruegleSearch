      "pattern": "\\b(hardware|home\\s*improvement|diy)\\b",
      "tags": [
        "shop=hardware",
        "shop=doityourself"
      ]
    },
    {
      "pattern": "\\b(barber|salon|hairdress\\w*|haircut)\\b",
      "tags": [
        "shop=hairdresser"
      ]
    },
    {
      "pattern": "\\b(mechanic|car\\s*repair|auto\\s*repair|garage)\\b",
      "tags": [
        "shop=car_repair"
      ]
    },
    {
      "pattern": "\\b(parking|car\\s*park)\\b",
      "tags": [
        "amenity=parking"
      ]
    },
