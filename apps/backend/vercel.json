{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/refresh-top-feed",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/refresh-top-feed",
      "schedule": "0 17 * * *"
    }
  ]
}
