# =============================================================================
# Truegle backend environment — CANONICAL MANIFEST (single source of truth)
# =============================================================================
# Copy this file to `.env` (which is gitignored) and fill in real values.
# This example file carries NO secrets and IS committed on purpose, so the set
# of variables and what each one does never has to be re-derived again.
#
#   cp apps/backend/.env.example apps/backend/.env
#
# Missing OPTIONAL keys degrade gracefully (that provider/feature just hides).
# Only the "REQUIRED TO BOOT" block below must be present or the server refuses
# to start (Joi validation in config/env.js).
# =============================================================================

# ----------------------------------------------------------------------------
# REQUIRED TO BOOT — the server throws on startup without these five.
# ----------------------------------------------------------------------------
# Postgres. LOCAL DEV: point at the local dev DB (see DEV-SETUP.md), never prod.
#   local example: postgresql://truegle@localhost:5432/truegle_dev?sslmode=disable
DATABASE_URL=
# Any long random string in dev (openssl rand -hex 32). Prod uses a real secret.
JWT_SECRET=
# Exactly 32 chars.
ENCRYPTION_KEY=
# Google Programmable Search — the blue-page result engine.
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# ----------------------------------------------------------------------------
# CORE RUNTIME (safe defaults; override only if needed)
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,image/gif

# ----------------------------------------------------------------------------
# AI ENGINE — TrueGLE (internal codename "nephesh" kept in the var names).
# With NEPHESH_BASE_URL unset, the first available provider below serves all AI
# (currently Groq). Multiple GROQ keys rotate on 429. See .claude/memory digest.
# ----------------------------------------------------------------------------
NEPHESH_BASE_URL=              # self-hosted TrueGLE (Ollama endpoint); unset = fallback chain
NEPHESH_AUTH_TOKEN=            # required only for a non-localhost NEPHESH_BASE_URL
NEPHESH_MODEL=nephesh:1.3
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=               # add this to give refusal-failover a DIFFERENT provider
GEMINI_MODEL=
NVIDIA_API_KEY=
NVIDIA_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=
OPENROUTER_API_KEY_5=
OPENROUTER_API_KEY_6=
OPENROUTER_API_KEY_UNLIMITED=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
HUGGINGFACE_API_KEY=
OPENAI_API_KEY=               # user decision: OpenAI is banned outright — leave blank
OLLAMA_BASE_URL=
OLLAMA_AUTH_TOKEN=
OLLAMA_MODEL=

# ----------------------------------------------------------------------------
# SEARCH — SearXNG (self-hosted metasearch) + optional paid fallbacks
# ----------------------------------------------------------------------------
SEARXNG_URL=                  # e.g. the AWS EC2 SearXNG instance
SEARXNG_PRIMARY=false
SEARXNG_PRIMARY_MIN=5
SEARXNG_RESULT_PROXY_URL=     # Morty result proxy for anonymous view
SEARXNG_RESULT_PROXY_KEY=     # base64 HMAC key matching the proxy settings.yml
SEARXNG_SUFFICIENT=20         # SearXNG count that counts as a FULL page; below
                              # this the API providers top up instead of being
                              # skipped. Do not confuse with PRIMARY_MIN, which
                              # is only the floor for treating SearXNG as alive.

# Per-mode engine sets — this is how modes RETRIEVE differently instead of
# re-sorting one shared list. Comma-separated SearXNG engine names; they must
# match what the instance actually has ENABLED (check its /config endpoint).
# Unset = the defaults in data/modeEngines.js. Set to EMPTY = instance default
# for that mode. A wrong name is survivable: SearchService retries unscoped when
# an engine-scoped query comes back thin.
SEARXNG_ENGINES_BLUE_PILL=    # default: google,bing,duckduckgo,wikipedia
SEARXNG_ENGINES_GREEN=        # default: same as blue-pill
SEARXNG_ENGINES_RED_PILL=     # default: mojeek,brave,marginalia,mwmbl,duckduckgo
SEARXNG_ENGINES_PURPLE=       # default: widest mix — it filters down afterwards
BRAVE_API_KEY=
BING_API_KEY=
SERP_API_KEY=
NEWS_API_KEY=
YOUTUBE_API_KEY=

# ----------------------------------------------------------------------------
# CONTENT EXTRACTION (transcripts / OSINT)
# ----------------------------------------------------------------------------
TRANSCRIPT_INVIDIOUS_INSTANCES=   # comma list; empty = built-in defaults
TRANSCRIPT_PROXY_URL=             # optional HTTP(S) proxy for direct-scrape fallback
SHODAN_API_KEY=
HUNTER_IO_API_KEY=
APIFY_API_KEY=
BRIGHT_DATA_API_KEY=
ENSEMBLE_SOCIAL_API_KEY=


# ----------------------------------------------------------------------------
# EMAIL — Resend (transactional) + optional SMTP
# REQUIRED for sign-in: auth is now passwordless/code-only (see routes/auth.js
# POST /request-code) — without a real RESEND_API_KEY, no one can sign in.
# Resend has a free tier; this should stay within the $0 budget.
# ----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ----------------------------------------------------------------------------
# PAYMENTS / MONETIZATION
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
ADSENSE_PUBLISHER_ID=
ADMOB_APP_ID=
ADMOB_API_KEY=

# ----------------------------------------------------------------------------
# MAPS / MEDIA / SPEECH / MISC PROVIDERS
# ----------------------------------------------------------------------------
MAPBOX_ACCESS_TOKEN=
TOMTOM_API_KEY=
RADAR_LIVE_PUBLISHABLE_KEY=
RADAR_LIVE_SECRET_KEY=
RADAR_TEST_PUBLISHABLE_KEY=
RADAR_TEST_SECRET_KEY=
OPENWEATHER_API_KEY=
OPENWEATHER_API_KEY_2=
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
UNSPLASH_ACCOUNT_ID=
DEEPGRAM_API_KEY=
STT_API_KEY=
STT_BASE_URL=
STT_MODEL=

# ----------------------------------------------------------------------------
# INFRA / OBSERVABILITY (optional)
# ----------------------------------------------------------------------------
REDIS_URL=
SENTRY_DSN=
