# =============================================================================
# Truegle frontend environment — CANONICAL MANIFEST (single source of truth)
# =============================================================================
# Vite only exposes vars prefixed VITE_. Copy to `.env` (gitignored) for local
# dev. All optional — the app degrades gracefully when one is unset.
#   cp apps/frontend/.env.example apps/frontend/.env
# =============================================================================

# Backend API base. LOCAL DEV points at the local backend; prod at Vercel.
# NEVER use VERCEL_URL (changes per deploy) — this is the stable override.
VITE_BACKEND_URL=http://localhost:3001

# Google Programmable Search (client-side widgets)
VITE_GOOGLE_SEARCH_ENGINE_ID=
VITE_GOOGLE_SHOPPING_ENGINE_ID=

# Maps
VITE_MAPBOX_ACCESS_TOKEN=

# Payments
VITE_PAYPAL_CLIENT_ID=

# Ads (Adsterra) — leave blank in dev to keep ad slots inert
# NOTE: VITE_POP_SCRIPT_URL and VITE_SOCIAL_BAR_SCRIPT_URL were DELETED.
# Popunders and social bars are permanently banned — see docs/AD-POLICY.md.
# Do not re-add them here or in any deployment environment.
VITE_AD_DOMAIN=
VITE_SMARTLINK_URL=
