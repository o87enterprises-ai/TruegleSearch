# Cloudflare Pages applies these HTTP response headers to every route.
# Lives in public/ so Vite copies it to dist/_headers on each build.

# /_index (written by scripts/prerender.mjs) is the SPA-shell file _redirects
# rewrites client-routed paths to. It's extension-less on purpose - see the
# comment in public/_redirects - so Pages can't infer its Content-Type from
# the filename and would otherwise serve it as application/octet-stream.
#
# Cloudflare Pages matches _headers rules against the ORIGINALLY REQUESTED
# path, not the path a _redirects rule rewrites it to - confirmed live: a
# request to /search (which _redirects rewrites to /_index) came back as
# application/octet-stream even with the /_index rule below in place, while
# a direct request to /_index itself got the right Content-Type. So every
# source path listed in _redirects needs its own matching rule here too.
/_index
  Content-Type: text/html; charset=utf-8

/search
  Content-Type: text/html; charset=utf-8
  X-Robots-Tag: noindex, follow
/search/*
  Content-Type: text/html; charset=utf-8
  X-Robots-Tag: noindex, follow
/chat
  Content-Type: text/html; charset=utf-8
/s/*
  Content-Type: text/html; charset=utf-8
  X-Robots-Tag: noindex, follow
# /w carries user-supplied media URLs in its query string — shareable, but not
# something to index.
/w
  Content-Type: text/html; charset=utf-8
  X-Robots-Tag: noindex, follow
/shorts
  Content-Type: text/html; charset=utf-8
/tube
  Content-Type: text/html; charset=utf-8
# /l carries a user-supplied destination in its query string — shareable, but
# not something to index.
/l
  Content-Type: text/html; charset=utf-8
  X-Robots-Tag: noindex, follow
/extract
  Content-Type: text/html; charset=utf-8

/feed
