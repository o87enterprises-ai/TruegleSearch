import { useEffect, useRef, useCallback, useState } from 'react';

export default function WarpTunnel() {
  const canvasRef = useRef(null);
  const animationFrameId = useRef(0);
  const lastTimeRef = useRef(0);
  const streaks = useRef([]);
  const [warpFactor, setWarpFactor] = useState(0);
  const speed = useRef(0);
  const warpSpeedTarget = useRef(0);
  const tunnelActive = useRef(true);
  const streakRespawnQueue = useRef([]);

  const tunnelPresets = [
    { colors: ['#00E5FF', '#0088FF', '#8B5CF6', '#FF00FF', '#FFFFFF'], speed: 0.2, name: 'Chill Mode' },
    { colors: ['#00E5FF', '#0088FF', '#8B5CF6', '#FF00FF', '#FFFFFF'], speed: 0.4, name: 'Slow Cruise' },
    { colors: ['#FF0080', '#FF00FF', '#8000FF', '#0080FF', '#FFFFFF'], speed: 0.7, name: 'Standard Warp' },
    { colors: ['#00FF88', '#00FFFF', '#0088FF', '#8B5CF6', '#FFFFFF'], speed: 1.0, name: 'High Speed' },
    { colors: ['#FFD700', '#FFA500', '#FF6B6B', '#FF1493', '#FFFFFF'], speed: 1.3, name: 'Hyperdrive' },
    { colors: ['#00E5FF', '#00FF00', '#FFFF00', '#FF00FF', '#FFFFFF'], speed: 1.6, name: 'Ludicrous Speed' },
  ];
  const [preset, setPreset] = useState(() => tunnelPresets[0]);
  const colors = preset.colors;
  const speedMultiplier = preset.speed;
  
  const config = useRef({
    streakCount: 60,
    baseSpeed: 0.8 * speedMultiplier,
    maxSpeed: 8 * speedMultiplier,
    acceleration: 0.3,
    tunnelRadius: 300,
    fov: 1000,
    minTrailLength: 300,
    maxTrailLength: 600,
    minStreakDistance: 2000,
    maxStreakDistance: 4000,
    spawnAngleOffset: 0,
  });

  const time = useRef(0);
  
  const initStreaks = useCallback((canvas) => {
    streaks.current = [];
    const centerX = canvas.width / 2;
    const centerY = canvas.height / 2;
    
    const angleStep = (2 * Math.PI) / config.current.streakCount;
    
    for (let i = 0; i < config.current.streakCount; i++) {
      const baseAngle = (i * angleStep) + config.current.spawnAngleOffset;
      const z = 1000 + (i * (3000 / config.current.streakCount));
      const radius = config.current.tunnelRadius * (0.7 + Math.random() * 0.6);
      const angle = baseAngle + (Math.random() - 0.5) * 0.2;
      const x = Math.cos(angle) * radius;
      const y = Math.sin(angle) * radius;
      const trailLength = config.current.minTrailLength + Math.random() * (config.current.maxTrailLength - config.current.minTrailLength);
      const size = 0.6 + Math.random() * 0.8;
      const color = colors[Math.floor(Math.random() * Math.min(3, colors.length))];
      const speedMultiplier = 0.8 + Math.random() * 0.4;
      const brightness = 0.7 + Math.random() * 0.3;
      
      streaks.current.push({
        id: i,
        x, y, z,
        baseAngle,
        angle,
        radius,
        color,
        size,
        speed: config.current.baseSpeed * speedMultiplier,
        trailLength,
        brightness,
        fadeIn: Math.random() * 50,
        maxFadeIn: 80 + Math.random() * 70,
        spawnTime: performance.now(),
      });
    }
    
    streakRespawnQueue.current = [...streaks.current].sort((a, b) => a.z - b.z);
  }, [colors]);
  
  const updateStreaks = useCallback((canvas, deltaTime) => {
    const dt = Math.min(deltaTime / 16, 2) * 0.7;
    
    if (tunnelActive.current) {
      warpSpeedTarget.current = config.current.maxSpeed;
    } else {
      warpSpeedTarget.current = config.current.baseSpeed;
    }
    
    const speedDiff = warpSpeedTarget.current - speed.current;
    const accelerationFactor = config.current.acceleration * (0.5 + 0.5 * Math.cos(time.current * 0.001));
    speed.current += speedDiff * accelerationFactor * dt;
    
    const currentWarpFactor = Math.min(1, speed.current / config.current.maxSpeed);
    setWarpFactor(currentWarpFactor);
    
    let activeStreaks = 0;
    streaks.current.forEach((streak, index) => {
      const speedVariation = 0.9 + Math.sin(streak.id * 0.1 + time.current * 0.001) * 0.1;
      streak.z -= speed.current * dt * speedVariation;
      
      if (streak.fadeIn < streak.maxFadeIn) {
        streak.fadeIn += dt * 1.5;
      }
      
      const screenX = canvas.width / 2 + streak.x * (config.current.fov / Math.max(streak.z, 1));
      const screenY = canvas.height / 2 + streak.y * (config.current.fov / Math.max(streak.z, 1));
      
      const isOffscreen = 
        streak.z < -500 || 
        screenX < -canvas.width * 0.2 || 
        screenX > canvas.width * 1.2 || 
        screenY < -canvas.height * 0.2 || 
        screenY > canvas.height * 1.2;
      
      if (isOffscreen && streak.fadeIn >= streak.maxFadeIn * 0.8) {
        const angleStep = (2 * Math.PI) / config.current.streakCount;
        const baseAngle = (index * angleStep + config.current.spawnAngleOffset + time.current * 0.0001) % (2 * Math.PI);
        const angle = baseAngle + (Math.random() - 0.5) * 0.1;
        
        streak.z = config.current.minStreakDistance + Math.random() * config.current.maxStreakDistance;
        streak.angle = angle;
        streak.radius = config.current.tunnelRadius * (0.7 + Math.random() * 0.6);
        streak.x = Math.cos(angle) * streak.radius;
        streak.y = Math.sin(angle) * streak.radius;
        
        streak.fadeIn = 0;
        streak.maxFadeIn = 60 + Math.random() * 40;
        streak.spawnTime = performance.now();
      } else {
        activeStreaks++;
      }
    });
    
    config.current.spawnAngleOffset += dt * 0.001;
    time.current += dt;
  }, []);
  
  const drawStreaks = useCallback((ctx, canvas, warpFactor) => {
    const centerX = canvas.width / 2;
    const centerY = canvas.height / 2;
    const sortedStreaks = [...streaks.current].sort((a, b) => b.z - a.z);
    
    sortedStreaks.forEach(streak => {
      if (streak.z <= 0 || streak.fadeIn < 30) return;
      
      const fadeProgress = Math.min(1, streak.fadeIn / streak.maxFadeIn);
      const fadeAlpha = fadeProgress * fadeProgress;
      
      const scale = config.current.fov / Math.max(streak.z, 1);
      const screenX = centerX + streak.x * scale;
      const screenY = centerY + streak.y * scale;
      
      const trailLengthMultiplier = 1 + warpFactor * 3;
      const trailZ = streak.z + streak.trailLength * trailLengthMultiplier;
      const trailScale = config.current.fov / Math.max(trailZ, 1);
      const trailX = centerX + streak.x * trailScale;
      const trailY = centerY + streak.y * trailScale;
      
      const trailLength = Math.sqrt(
        Math.pow(screenX - trailX, 2) + Math.pow(screenY - trailY, 2)
      );
      
      if (trailLength < 5) return;
      
      const distanceFactor = Math.max(0.2, 1 - streak.z / 6000);
      const ageFactor = Math.min(1, (performance.now() - streak.spawnTime) / 2000);
      const finalBrightness = streak.brightness * distanceFactor * ageFactor;
      const size = Math.max(0.4, streak.size * (0.8 + warpFactor * 0.4));
      
      const gradient = ctx.createLinearGradient(trailX, trailY, screenX, screenY);
      
      const mainAlpha = Math.floor(255 * finalBrightness * fadeAlpha).toString(16).padStart(2, '0');
      const midAlpha = Math.floor(180 * finalBrightness * fadeAlpha).toString(16).padStart(2, '0');
      const startAlpha = Math.floor(100 * finalBrightness * fadeAlpha).toString(16).padStart(2, '0');
      
      gradient.addColorStop(0, streak.color + startAlpha);
      gradient.addColorStop(0.3, streak.color + midAlpha);
      gradient.addColorStop(0.7, streak.color + mainAlpha);
      gradient.addColorStop(1, streak.color + mainAlpha);
      
      ctx.save();
      ctx.beginPath();
      ctx.moveTo(trailX, trailY);
      ctx.lineTo(screenX, screenY);
      ctx.strokeStyle = gradient;
      
      const baseWidth = Math.max(0.6, size * (0.4 + warpFactor * 0.3));
      
      ctx.lineWidth = baseWidth;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      ctx.shadowBlur = 8 + warpFactor * 12;
      ctx.shadowColor = streak.color;
      ctx.stroke();
      
      if (finalBrightness > 0.6) {
        ctx.lineWidth = baseWidth * 1.5;
        ctx.strokeStyle = streak.color + '30';
        ctx.shadowBlur = 4;
        ctx.stroke();
      }
      
      ctx.restore();
      
      ctx.save();
      ctx.beginPath();
      const headSize = Math.max(0.8, baseWidth * 0.9);
      ctx.arc(screenX, screenY, headSize, 0, Math.PI * 2);
      ctx.fillStyle = streak.color + mainAlpha;
      ctx.shadowBlur = 15;
      ctx.shadowColor = streak.color;
      ctx.fill();
      ctx.restore();
    });
  }, []);
  
  const render = useCallback((timestamp) => {
    if (!canvasRef.current) return;
    
    const canvas = canvasRef.current;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    
    const trailOpacity = Math.max(0.02, 0.1 - warpFactor * 0.08);
    ctx.fillStyle = `rgba(2, 5, 15, ${trailOpacity})`;
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    
    if (warpFactor > 0.3) {
      const gradient = ctx.createRadialGradient(
        canvas.width / 2, canvas.height / 2, 0,
        canvas.width / 2, canvas.height / 2, Math.max(canvas.width, canvas.height) * 0.7
      );
      gradient.addColorStop(0, `rgba(0, 20, 40, ${0.02 + warpFactor * 0.03})`);
      gradient.addColorStop(1, 'rgba(2, 5, 15, 0)');
      
      ctx.save();
      ctx.globalCompositeOperation = 'screen';
      ctx.fillStyle = gradient;
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.restore();
    }
    
    const deltaTime = timestamp - (lastTimeRef.current || timestamp);
    lastTimeRef.current = timestamp;
    
    updateStreaks(canvas, deltaTime);
    drawStreaks(ctx, canvas, warpFactor);
    
    animationFrameId.current = requestAnimationFrame(render);
  }, [warpFactor, updateStreaks, drawStreaks]);
  
  useEffect(() => {
    const startWarpSequence = () => {
      warpSpeedTarget.current = config.current.baseSpeed;
      
      const accelerate = (target, delay) => {
        setTimeout(() => {
          warpSpeedTarget.current = target;
        }, delay);
      };
      
      accelerate(config.current.maxSpeed * 0.2, 800);
      accelerate(config.current.maxSpeed * 0.5, 1800);
      accelerate(config.current.maxSpeed * 0.8, 3000);
      accelerate(config.current.maxSpeed, 4500);
    };
    
    startWarpSequence();
  }, []);
  
  useEffect(() => {
    const handleKeyPress = (e) => {
      if (e.key === ' ') {
        const randomPreset = tunnelPresets[Math.floor(Math.random() * tunnelPresets.length)];
        setPreset(randomPreset);
      }
    };
    window.addEventListener('keydown', handleKeyPress);
    return () => window.removeEventListener('keydown', handleKeyPress);
  }, []);
  
  const handleClick = () => {
    tunnelActive.current = !tunnelActive.current;
    if (!tunnelActive.current) {
      warpSpeedTarget.current = config.current.baseSpeed;
    }
  };
  
  useEffect(() => {
    const canvas = canvasRef.current;
    if (!canvas) return;
    
    const resize = () => {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
      initStreaks(canvas);
    };
    
    const handleVisibilityChange = () => {
      if (document.hidden) {
        cancelAnimationFrame(animationFrameId.current);
      } else {
        lastTimeRef.current = 0;
        animationFrameId.current = requestAnimationFrame(render);
      }
    };
    
    resize();
    window.addEventListener('resize', resize);
    document.addEventListener('visibilitychange', handleVisibilityChange);
    
    animationFrameId.current = requestAnimationFrame(render);
    
    return () => {
      window.removeEventListener('resize', resize);
      document.removeEventListener('visibilitychange', handleVisibilityChange);
      cancelAnimationFrame(animationFrameId.current);
    };
  }, [initStreaks, render]);
  
  return (
    <div 
      className="absolute inset-0 w-full h-full overflow-hidden cursor-pointer"
      onClick={handleClick}
    >
      <div className="absolute inset-0 bg-gradient-to-br from-black via-blue-950/10 to-black" />
      
      <canvas
        ref={canvasRef}
        className="absolute inset-0 w-full h-full"
        style={{
          filter: `
            contrast(${1 + warpFactor * 0.4})
            brightness(${1 + warpFactor * 0.1})
            blur(${warpFactor * 0.3}px)
          `,
        }}
      />
      
      <div className="absolute bottom-8 left-8 font-mono text-sm">
        <div className="flex flex-col gap-2">
          <div className="flex items-center gap-3">
            <div className="relative w-40 h-2 bg-gray-900/60 rounded-full overflow-hidden">
              <div 
                className="absolute inset-y-0 left-0 bg-gradient-to-r from-cyan-500 via-blue-500 to-purple-500 rounded-full transition-all duration-700"
                style={{ width: `${warpFactor * 100}%` }}
              />
            </div>
            <div className="text-cyan-300/80 tracking-widest text-sm">
              {warpFactor < 0.3 ? 'SUBLIGHT' : warpFactor < 0.7 ? 'WARP' : 'MAX WARP'}
            </div>
          </div>
          <div className="text-gray-500 text-xs">
            Click or press SPACE to {tunnelActive.current ? 'decelerate' : 'engage warp'}
          </div>
        </div>
      </div>
      
      {warpFactor > 0.5 && (
        <div className="absolute inset-0 pointer-events-none">
          <div 
            className="absolute inset-0 bg-gradient-to-r from-transparent via-white/2 to-transparent"
            style={{
              animation: 'speed-lines 2s linear infinite',
              opacity: 0.03 + warpFactor * 0.05,
            }}
          />
        </div>
      )}
      
      <div className="absolute inset-0 pointer-events-none">
        <div className="absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_40%,rgba(0,0,0,0.6)_80%,rgba(0,0,0,0.9)_100%)]" />
      </div>
      
      <style>{`
        @keyframes speed-lines {
          0% {
            transform: translateX(-100%) skewX(-5deg);
          }
          100% {
            transform: translateX(100%) skewX(-5deg);
          }
        }
      `}</style>
    </div>
  );
}
