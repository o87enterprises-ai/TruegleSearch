import { useEffect, useRef, useCallback, useState } from 'react';

export default function WarpTunnel() {
  const canvasRef = useRef(null);
  const animationFrameId = useRef(0);
  const lastTimeRef = useRef(0);
  const streaks = useRef([]);
  const [warpFactor, setWarpFactor] = useState(0);
  const speed = useRef(0);
  const warpSpeedTarget = useRef(0);
  const tunnelActive = useRef(true);

  // Matched color schemes with distinct speed presets
  const tunnelPresets = [
    { colors: ['#00E5FF', '#0088FF', '#8B5CF6', '#FF00FF', '#FFFFFF'], speed: 0.3, name: 'Chill Mode' },
    { colors: ['#00E5FF', '#0088FF', '#8B5CF6', '#FF00FF', '#FFFFFF'], speed: 0.6, name: 'Slow Cruise' },
    { colors: ['#FF0080', '#FF00FF', '#8000FF', '#0080FF', '#FFFFFF'], speed: 1.0, name: 'Standard Warp' },
    { colors: ['#00FF88', '#00FFFF', '#0088FF', '#8B5CF6', '#FFFFFF'], speed: 1.4, name: 'High Speed' },
    { colors: ['#FFD700', '#FFA500', '#FF6B6B', '#FF1493', '#FFFFFF'], speed: 1.8, name: 'Hyperdrive' },
    { colors: ['#00E5FF', '#00FF00', '#FFFF00', '#FF00FF', '#FFFFFF'], speed: 2.2, name: 'Ludicrous Speed' },
  ];
  const [preset, setPreset] = useState(() => tunnelPresets[0]);
  const colors = preset.colors;
  const speedMultiplier = preset.speed;
  // Simplified configuration
  const config = {
    streakCount: 43,
    baseSpeed: 1.09 * speedMultiplier,
    maxSpeed: 15 * speedMultiplier,
    acceleration: 0.6,
    tunnelRadius: 250,
    fov: 800,
    minTrailLength: 100,
    maxTrailLength: 250,
  };
  
  const time = useRef(0);
  
  // Initialize only streaks (no background particles)
  const initStreaks = useCallback((canvas) => {
    streaks.current = [];
    const centerX = canvas.width / 2;
    const centerY = canvas.height / 2;
    
    for (let i = 0; i < config.streakCount; i++) {
      // Start streaks at various distances
      const z = Math.random() * 4000 + 1000; // Closer start for immediate effect
      const angle = Math.random() * Math.PI * 2;
      const radius = config.tunnelRadius * (0.3 + Math.random() * 0.7);
      
      // Position in 3D
      const x = Math.cos(angle) * radius;
      const y = Math.sin(angle) * radius;
      
      // Streak properties
      const trailLength = config.minTrailLength + Math.random() * (config.maxTrailLength - config.minTrailLength);
      const size = 0.8 + Math.random() * 1.2; // Very thin streaks
      const color = colors[Math.floor(Math.random() * Math.min(3, colors.length))]; // Mostly blues/cyans
      const speedMultiplier = 0.7 + Math.random() * 0.6;
      const brightness = 0.6 + Math.random() * 0.4;
      
      streaks.current.push({
        id: i,
        x, y, z,
        angle,
        radius,
        color,
        size,
        speed: config.baseSpeed * speedMultiplier,
        trailLength,
        brightness,
        // For gradual appearance
        fadeIn: Math.random() * 100, // Start with staggered fade-in
        maxFadeIn: 100 + Math.random() * 100,
      });
    }
  }, [config.streakCount, config.tunnelRadius, config.baseSpeed]);
  
  const updateStreaks = useCallback((canvas, deltaTime) => {
    const dt = Math.min(deltaTime / 16, 2);
    
    // Smooth speed control
    if (tunnelActive.current) {
      warpSpeedTarget.current = config.maxSpeed;
    } else {
      warpSpeedTarget.current = config.baseSpeed;
    }
    
    speed.current += (warpSpeedTarget.current - speed.current) * config.acceleration * dt;
    
    // Calculate warp factor
    const currentWarpFactor = Math.min(1, speed.current / config.maxSpeed);
    setWarpFactor(currentWarpFactor);
    
    // Update streaks
    streaks.current.forEach(streak => {
      // Move streak toward viewer
      streak.z -= speed.current * dt * (0.8 + Math.random() * 0.4);
      
      // Fade in new streaks
      if (streak.fadeIn < streak.maxFadeIn) {
        streak.fadeIn += dt * 2;
      }
      
      // Add subtle spiral motion at higher speeds
      if (currentWarpFactor > 0.3) {
        streak.angle += (currentWarpFactor * 0.01) * dt;
//         streak.x = Math.cos(streak.angle) * streak.radius;
//         streak.y = Math.sin(streak.angle) * streak.radius;
      }
      
      // Reset when past viewer or faded out
      if (streak.z < -200) {
        // Place at far end
        streak.z = 5000 + Math.random() * 2000;
        
        // New position
        const newAngle = Math.random() * Math.PI * 2;
        const newRadius = config.tunnelRadius * (0.2 + Math.random() * 0.8);
        streak.angle = newAngle;
        streak.radius = newRadius;
//         streak.x = Math.cos(newAngle) * newRadius;
//         streak.y = Math.sin(newAngle) * newRadius;
        
        // Reset fade
        streak.fadeIn = 0;
        streak.maxFadeIn = 50 + Math.random() * 150;
      }
    });
    
    time.current += dt;
  }, [config.maxSpeed, config.acceleration, config.tunnelRadius]);
  
  const drawStreaks = useCallback((ctx, canvas, warpFactor) => {
    const centerX = canvas.width / 2;
    const centerY = canvas.height / 2;
    
    // Sort by depth (far to near)
    const sortedStreaks = [...streaks.current].sort((a, b) => b.z - a.z);
    
    sortedStreaks.forEach(streak => {
      // Skip if behind camera or not faded in
      if (streak.z <= 0 || streak.fadeIn < 50) return;
      
      // Calculate fade alpha
      const fadeAlpha = Math.min(1, (streak.fadeIn - 50) / 50);
      
      // Perspective projection
      const scale = config.fov / Math.max(streak.z, 1);
      const screenX = centerX + streak.x * scale;
      const screenY = centerY + streak.y * scale;
      
      // Skip if off screen
      const margin = 300;
      if (screenX < -margin || screenX > canvas.width + margin ||
          screenY < -margin || screenY > canvas.height + margin) {
        return;
      }
      
      // Calculate trail end (previous position)
      const trailZ = streak.z + streak.trailLength * (1 + warpFactor * 2);
      const trailScale = config.fov / Math.max(trailZ, 1);
      const trailX = centerX + streak.x * trailScale;
      const trailY = centerY + streak.y * trailScale;
      
      // Skip if trail is too short
      const trailLength = Math.sqrt(
        Math.pow(screenX - trailX, 2) + Math.pow(screenY - trailY, 2)
      );
      
      if (trailLength < 10) return;
      
      // Calculate brightness and size
      const distanceBrightness = Math.max(0.1, 1 - streak.z / 4000);
      const finalBrightness = streak.brightness * distanceBrightness * (1 + warpFactor * 0.2);
      const size = Math.max(0.5, streak.size * (1 + warpFactor * 0.3));
      
      // Create gradient for streak
      const gradient = ctx.createLinearGradient(trailX, trailY, screenX, screenY);
      
      // Warp factor affects color intensity
      const colorIntensity = Math.min(255, Math.floor(255 * finalBrightness * fadeAlpha)).toString(16).padStart(2, '0');
      const midIntensity = Math.min(180, Math.floor(180 * finalBrightness * fadeAlpha)).toString(16).padStart(2, '0');
      const startIntensity = Math.min(80, Math.floor(80 * finalBrightness * fadeAlpha)).toString(16).padStart(2, '0');
      
      gradient.addColorStop(0, streak.color + startIntensity);     // Faint at start
      gradient.addColorStop(0.2, streak.color + midIntensity);    // Build up
      gradient.addColorStop(0.6, streak.color + colorIntensity);  // Bright middle
      gradient.addColorStop(1, streak.color + colorIntensity);    // Bright at end
      
      // Draw the streak
      ctx.save();
      ctx.beginPath();
      ctx.moveTo(trailX, trailY);
      ctx.lineTo(screenX, screenY);
      ctx.strokeStyle = gradient;
      
      // Vary width based on position and speed
      const baseWidth = Math.max(0.8, size * (0.3 + warpFactor * 0.2));
      
      // Draw primary streak line
      ctx.lineWidth = baseWidth;
      ctx.lineCap = 'round';
      ctx.shadowBlur = 10 * warpFactor;
      ctx.shadowColor = streak.color;
      ctx.stroke();
      
      // Draw a subtle outer glow for brighter streaks
      if (finalBrightness > 0.7) {
        ctx.lineWidth = baseWidth * 2;
        ctx.strokeStyle = streak.color + '40';
        ctx.shadowBlur = 5;
        ctx.stroke();
      }
      
      ctx.restore();
      
      // Draw a small bright head for the streak
      ctx.save();
      ctx.beginPath();
      ctx.arc(screenX, screenY, Math.max(1, baseWidth * 0.7), 0, Math.PI * 2);
      ctx.fillStyle = streak.color + colorIntensity;
      ctx.fill();
      ctx.restore();
    });
  }, [config.fov]);
  
  const drawTunnelStructure = useCallback((ctx, canvas, warpFactor) => {
    const centerX = canvas.width / 2;
    const centerY = canvas.height / 2;
    
    
    // Central energy core (very subtle)
    if (warpFactor > 0.5) {
      const coreSize = 80 * (1 + Math.sin(time.current * 0.003) * 0.1);
      const coreIntensity = warpFactor * 0.4;
      
      const gradient = ctx.createRadialGradient(
        centerX, centerY, 0,
        centerX, centerY, coreSize
      );
      
      gradient.addColorStop(0, `rgba(0, 229, 255, ${coreIntensity * 0.3})`);
      gradient.addColorStop(0.7, `rgba(0, 136, 255, ${coreIntensity * 0.1})`);
      gradient.addColorStop(1, 'rgba(0, 229, 255, 0)');
      
      ctx.save();
      ctx.beginPath();
      ctx.arc(centerX, centerY, coreSize, 0, Math.PI * 2);
      ctx.fillStyle = gradient;
      ctx.fill();
      ctx.restore();
    }
  }, [config.fov, config.tunnelRadius]);
  
  const render = useCallback((timestamp) => {
    if (!canvasRef.current) return;
    
    const canvas = canvasRef.current;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    
    // Clear with very dark blue (almost black)
    const trailOpacity = Math.max(0.05, 0.15 - warpFactor * 0.1);
    ctx.fillStyle = `rgba(5, 10, 25, ${trailOpacity})`;
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    
    const deltaTime = timestamp - (lastTimeRef.current || timestamp);
    lastTimeRef.current = timestamp;
    
    updateStreaks(canvas, deltaTime);
    
    // Draw elements (background to foreground)
    drawTunnelStructure(ctx, canvas, warpFactor);
    drawStreaks(ctx, canvas, warpFactor);
    
    animationFrameId.current = requestAnimationFrame(render);
  }, [warpFactor, updateStreaks, drawTunnelStructure, drawStreaks]);
  
  // Start with warp active
  useEffect(() => {
    const startWarpSequence = () => {
      // Start at sublight, then accelerate
      warpSpeedTarget.current = config.baseSpeed;
      
      setTimeout(() => {
        warpSpeedTarget.current = config.maxSpeed * 0.3;
      }, 500);
      
      setTimeout(() => {
        warpSpeedTarget.current = config.maxSpeed * 0.7;
      }, 1500);
      
      setTimeout(() => {
        warpSpeedTarget.current = config.maxSpeed;
      }, 2500);
    };
    
    startWarpSequence();
  }, [config.baseSpeed, config.maxSpeed]);
  
  // Toggle warp with spacebar
  useEffect(() => {
    const handleKeyPress = (e) => {
      if (e.key === ' ') {
        const randomPreset = tunnelPresets[Math.floor(Math.random() * tunnelPresets.length)];
        setPreset(randomPreset);
      }
    };
    window.addEventListener('keydown', handleKeyPress);
    return () => window.removeEventListener('keydown', handleKeyPress);
  }, [config.baseSpeed]);
  
  // Click to toggle warp
  const handleClick = () => {
    tunnelActive.current = !tunnelActive.current;
    if (!tunnelActive.current) {
      warpSpeedTarget.current = config.baseSpeed;
    }
  };
  
  useEffect(() => {
    const canvas = canvasRef.current;
    if (!canvas) return;
    
    const resize = () => {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
      initStreaks(canvas);
    };
    
    const handleVisibilityChange = () => {
      if (document.hidden) {
        cancelAnimationFrame(animationFrameId.current);
      } else {
        lastTimeRef.current = 0;
        animationFrameId.current = requestAnimationFrame(render);
      }
    };
    
    resize();
    window.addEventListener('resize', resize);
    document.addEventListener('visibilitychange', handleVisibilityChange);
    
    animationFrameId.current = requestAnimationFrame(render);
    
    return () => {
      window.removeEventListener('resize', resize);
      document.removeEventListener('visibilitychange', handleVisibilityChange);
      cancelAnimationFrame(animationFrameId.current);
    };
  }, [initStreaks, render]);
  
  return (
    <div 
      className="absolute inset-0 w-full h-full overflow-hidden cursor-pointer"
      onClick={handleClick}
    >
      {/* Minimal background - just deep space */}
      <div className="absolute inset-0">
        <div className="absolute inset-0 bg-gradient-to-br from-black via-blue-950/20 to-black" />
        <div className="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(0,40,80,0.3)_0%,rgba(0,0,0,1)_100%)]" />
      </div>
      
      {/* Canvas for warp streaks */}
      <canvas
        ref={canvasRef}
        className="absolute inset-0 w-full h-full"
        style={{
          filter: `
            contrast(${1 + warpFactor * 0.6})
            brightness(${1 + warpFactor * 0.2})
          `,
        }}
      />
      
      {/* Minimal UI elements */}
      <div className="absolute bottom-8 left-8 font-mono text-sm">
        <div className="flex flex-col gap-2">
          <div className="flex items-center gap-3">
            <div className="relative w-40 h-2 bg-gray-900/60 rounded-full overflow-hidden">
              <div 
                className="absolute inset-y-0 left-0 bg-gradient-to-r from-cyan-500 via-blue-500 to-purple-500 rounded-full transition-all duration-500"
                style={{ width: `${warpFactor * 100}%` }}
              />
            </div>
            <div className="text-cyan-300/80 tracking-widest text-sm">
              {warpFactor < 0.3 ? 'SUBLIGHT' : warpFactor < 0.7 ? 'WARP' : 'MAX WARP'}
            </div>
          </div>
          <div className="text-gray-500 text-xs">
            Click or press SPACE to {tunnelActive.current ? 'decelerate' : 'engage warp'}
          </div>
        </div>
      </div>
      
      {/* Very subtle speed lines */}
      {warpFactor > 0.5 && (
        <div className="absolute inset-0 pointer-events-none">
          <div 
            className="absolute inset-0 bg-gradient-to-r from-transparent via-white/1 to-transparent"
            style={{
              animation: 'speed-lines 1.5s linear infinite',
              opacity: 0.05 + warpFactor * 0.1,
            }}
          />
        </div>
      )}
      
      {/* Clean vignette */}
      <div className="absolute inset-0 pointer-events-none">
        <div className="absolute inset-0 bg-[radial-gradient(circle_at_center,transparent_30%,rgba(0,0,0,0.4)_70%,rgba(0,0,0,0.8)_100%)]" />
      </div>
      
      <style>{`
        @keyframes speed-lines {
          0% {
            transform: translateX(-100%) skewX(-10deg);
          }
          100% {
            transform: translateX(100%) skewX(-10deg);
          }
        }
      `}</style>
    </div>
  );
}
