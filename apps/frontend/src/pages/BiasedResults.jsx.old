import { useState } from 'react';
import { useNavigate } from 'react-router-dom';
import { motion, AnimatePresence } from 'framer-motion';
import { ArrowLeft, Circle, ArrowRight, Minus, Star } from 'lucide-react';
import TruegleLogo from '../components/ui/TruegleLogo';
import SearchBar from '../components/ui/SearchBar';
import CategoryBar from '../components/ui/CategoryBar';
import PerspectiveCard from '../components/ui/PerspectiveCard';
import AdCard from '../components/ui/AdCard';

export default function BiasedResults() {
  const navigate = useNavigate();
  const [searchValue, setSearchValue] = useState('climate change policy');
  const [activeCategory, setActiveCategory] = useState('news');
  const [activePerspective, setActivePerspective] = useState('neutral');

  const handleSearch = () => {
    console.log('Searching:', searchValue);
  };

  // Results filtered by perspective
  const allResults = {
    left: [
      { id: 1, title: 'Green New Deal: Bold Climate Action Plan', snippet: 'Comprehensive approach to address climate crisis through government action...', source: 'Progressive Policy Institute' },
      { id: 2, title: 'Renewable Energy Investment Creates Jobs', snippet: 'Study shows green energy sector outpacing fossil fuels in employment...', source: 'Labor Research Center' },
      { id: 3, title: 'Corporate Accountability for Climate Change', snippet: 'Major polluters must face consequences for environmental damage...', source: 'Environmental Justice Coalition' },
    ],
    center: [
      { id: 4, title: 'Balanced Approach to Climate Policy Needed', snippet: 'Experts call for pragmatic solutions that address both environmental and economic concerns...', source: 'Policy Analysis Center' },
      { id: 5, title: 'Climate Science: What We Know and Don\'t Know', snippet: 'Comprehensive review of current climate research and uncertainties...', source: 'Science Journal' },
      { id: 6, title: 'Bipartisan Climate Solutions Gain Traction', snippet: 'Cross-party initiatives show promise for environmental legislation...', source: 'Congressional Quarterly' },
    ],
    right: [
      { id: 7, title: 'Market-Based Climate Solutions Show Promise', snippet: 'Innovation and free enterprise driving environmental improvements...', source: 'Economic Freedom Institute' },
      { id: 8, title: 'Energy Independence Through Domestic Production', snippet: 'Balancing environmental goals with national security needs...', source: 'Energy Policy Forum' },
      { id: 9, title: 'Cost-Benefit Analysis of Climate Regulations', snippet: 'Economic impact assessment of proposed environmental policies...', source: 'Fiscal Research Institute' },
    ],
    neutral: [
      { id: 10, title: 'Climate Data: Temperature Trends 1980-2024', snippet: 'Comprehensive analysis of global temperature measurements...', source: 'National Weather Service' },
      { id: 11, title: 'IPCC Report: Key Findings Summary', snippet: 'International panel releases latest climate assessment...', source: 'UN Climate Panel' },
      { id: 12, title: 'Peer-Reviewed Studies on Climate Models', snippet: 'Academic research compilation on climate prediction methods...', source: 'Journal of Climate Science' },
    ],
    custom: [
      { id: 13, title: 'Create Your Own Perspective Filter', snippet: 'Customize which sources and viewpoints you want to see...', source: 'Truegle Tools' },
    ],
  };

  const perspectiveIcons = {
    left: ArrowLeft,
    center: Circle,
    right: ArrowRight,
    neutral: Minus,
    custom: Star,
  };

  const perspectiveLabels = {
    left: 'Left',
    center: 'Center',
    right: 'Right',
    neutral: 'Neutral',
    custom: 'Custom',
  };

  // Ads that rotate based on perspective
  const perspectiveAds = {
    left: [
      { title: 'Solar Panel Installation', perspective: 'Left-leaning advertiser' },
      { title: 'Progressive Advocacy Groups', perspective: 'Left-leaning advertiser' },
    ],
    center: [
      { title: 'News Subscription Services', perspective: 'Neutral advertiser' },
      { title: 'Educational Resources', perspective: 'Neutral advertiser' },
    ],
    right: [
      { title: 'Energy Stocks Investment', perspective: 'Right-leaning advertiser' },
      { title: 'Business Consulting', perspective: 'Right-leaning advertiser' },
    ],
    neutral: [
      { title: 'General Product Ads', perspective: 'Neutral advertiser' },
      { title: 'Tech Services', perspective: 'Neutral advertiser' },
    ],
    custom: [
      { title: 'Customize Your Ads', perspective: 'Custom settings' },
    ],
  };

  const currentResults = allResults[activePerspective] || allResults.neutral;
  const currentAds = perspectiveAds[activePerspective] || perspectiveAds.neutral;

  return (
    <div className="min-h-screen bg-gradient-to-br from-black via-gray-900 to-black p-4 md:p-8">
      <div className="max-w-7xl mx-auto">
        
        {/* Logo */}
        <div className="flex justify-center mb-8">
          <button onClick={() => navigate('/')} className="inline-block">
            <TruegleLogo size="large" animated={true} />
          </button>
        </div>

        {/* Search Bar */}
        <div className="max-w-4xl mx-auto mb-6">
          <SearchBar
            value={searchValue}
            onChange={(e) => setSearchValue(e.target.value)}
            onSearch={handleSearch}
            size="large"
          />
        </div>

        {/* Category Bar */}
        <div className="mb-8">
          <CategoryBar
            activeCategory={activeCategory}
            onSelectCategory={setActiveCategory}
          />
        </div>

        {/* Perspective Cards (replaces AI Summary) */}
        <div className="mb-8">
          <h2 className="text-2xl font-bold text-cyan-400 mb-4 text-center">
            Choose Your Perspective
          </h2>
          <div className="flex gap-4 overflow-x-auto pb-4 px-4 scrollbar-hide justify-center flex-wrap">
            {Object.keys(allResults).map((perspective) => {
              const Icon = perspectiveIcons[perspective];
              return (
                <PerspectiveCard
                  key={perspective}
                  perspective={perspective}
                  isActive={activePerspective === perspective}
                  onClick={() => setActivePerspective(perspective)}
                  resultCount={allResults[perspective].length}
                />
              );
            })}
          </div>
        </div>

        {/* Results Section with Animation */}
        <div className="grid grid-cols-1 lg:grid-cols-4 gap-6">
          
          {/* Main Results */}
          <div className="lg:col-span-3">
            <div className="mb-4 flex items-center justify-between">
              <p className="text-gray-400">
                Showing <span className="text-cyan-400 font-semibold">{perspectiveLabels[activePerspective]}</span> perspective results
              </p>
              <p className="text-gray-500 text-sm">
                {currentResults.length} results
              </p>
            </div>

            <AnimatePresence mode="wait">
              <motion.div
                key={activePerspective}
                initial={{ opacity: 0, x: 20 }}
                animate={{ opacity: 1, x: 0 }}
                exit={{ opacity: 0, x: -20 }}
                transition={{ duration: 0.3 }}
                className="space-y-4"
              >
                {currentResults.map((result, index) => (
                  <motion.div
                    key={result.id}
                    initial={{ opacity: 0, y: 20 }}
                    animate={{ opacity: 1, y: 0 }}
                    transition={{ delay: index * 0.1 }}
                    className="bg-gray-900/50 backdrop-blur-md border border-cyan-500/20 rounded-xl p-6 hover:border-cyan-500/50 transition-all"
                  >
                    <h3 className="text-lg font-semibold text-white hover:text-cyan-400 cursor-pointer mb-2">
                      {result.title}
                    </h3>
                    <p className="text-gray-400 text-sm mb-2">{result.snippet}</p>
                    <p className="text-gray-500 text-xs">{result.source}</p>
                  </motion.div>
                ))}
              </motion.div>
            </AnimatePresence>
          </div>

          {/* Scrollable Ads Controller (Sidebar) */}
          <div className="lg:col-span-1">
            <div className="sticky top-4">
              <div className="bg-gray-900/80 backdrop-blur-md border border-cyan-500/20 rounded-xl p-4 mb-4">
                <h3 className="text-sm font-semibold text-cyan-400 mb-3">
                  Advertiser Perspective
                </h3>
                <p className="text-xs text-gray-400 mb-4">
                  These ads align with the <span className="text-white font-medium">{perspectiveLabels[activePerspective]}</span> perspective you selected.
                </p>
                
                <AnimatePresence mode="wait">
                  <motion.div
                    key={activePerspective}
                    initial={{ opacity: 0 }}
                    animate={{ opacity: 1 }}
                    exit={{ opacity: 0 }}
                    className="space-y-3"
                  >
                    {currentAds.map((ad, index) => (
                      <div
                        key={index}
                        className="bg-gray-800/50 border border-gray-700/50 rounded-lg p-3"
                      >
                        <p className="text-white text-sm font-medium mb-1">{ad.title}</p>
                        <p className="text-gray-500 text-xs">{ad.perspective}</p>
                      </div>
                    ))}
                  </motion.div>
                </AnimatePresence>
              </div>

              {/* Regular sidebar ad */}
              <AdCard size="sidebar" />
            </div>
          </div>
        </div>

        {/* Bottom Banner */}
        <div className="mt-8">
          <AdCard size="banner" />
        </div>

      </div>
    </div>
  );
}
