                transition={{ duration: 2, repeat: Infinity }}
                className="w-1.5 h-1.5 bg-cyan-500 rounded-full mt-2"
              />
            </div>
          </motion.div>
        </div>

        {/* Features Section */}
        <div id="features" className="py-20 px-4">
          <div className="max-w-7xl mx-auto">
            
            <motion.div
