              transition={{ delay: 0.9, duration: 0.5 }}
              className="flex flex-col sm:flex-row gap-4 justify-center"
            >
              <NeonButton
                variant="primary"
                size="lg"
                onClick={() => navigate('/search')}
                className="group"
              >
                <Search className="inline mr-2" size={20} />
