{
  "name": "@truegle/frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ],
  "scripts": {
    "dev": "vite",
    "check:ads": "node scripts/check-ads.mjs",
    "build": "npm run check:ads && NODE_OPTIONS='--max-old-space-size=4096' vite build && node scripts/prerender.mjs",
    "vercel-build": "npm run check:ads && NODE_OPTIONS='--max-old-space-size=4096' vite build && node scripts/prerender.mjs",
    "lint": "eslint .",
    "lint:error": "eslint . --quiet",
    "preview": "vite preview",
    "trail": "esbuild dev/trail.entry.js --bundle --format=esm --outfile=dev/.build/trail.js --servedir=dev --serve=5174",
    "trail:test": "esbuild scripts/verify-trail.mjs --bundle --format=esm --platform=node --outfile=dev/.build/trail-test.mjs --log-level=error && node dev/.build/trail-test.mjs",
    "trail:browser": "node scripts/verify-trail-browser.mjs",
    "vault:browser": "node scripts/verify-vault-browser.mjs",
    "feedpage:test": "node scripts/verify-feed-page.mjs",
    "vault:test": "esbuild scripts/verify-encyclopedia.mjs --bundle --format=esm --platform=node --loader:.md=text --outfile=dev/.build/vault-test.mjs --log-level=error && node dev/.build/vault-test.mjs",
    "player:test": "esbuild scripts/verify-player.mjs --bundle --format=esm --platform=node --outfile=dev/.build/player-test.mjs --external:esbuild --log-level=error && node dev/.build/player-test.mjs",
    "feed:test": "node scripts/verify-feed.mjs"
  },
  "dependencies": {
    "@mapbox/mapbox-sdk": "^0.16.2",
    "@paypal/react-paypal-js": "^10.1.0",
    "@questlabs/react-sdk": "latest",
    "@react-three/drei": "^9.112.0",
    "@react-three/fiber": "^8.15.19",
    "@supabase/supabase-js": "^2.39.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@tomtom-international/web-sdk-services": "^6.25.0",
    "@turf/turf": "^7.3.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "clsx": "^2.1.1",
    "date-fns": "4.1.0",
    "dompurify": "^3.4.5",
    "echarts": "^5.5.0",
    "echarts-for-react": "^3.0.2",
    "framer-motion": "^11.18.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.562.0",
    "mapbox-gl": "^3.18.0",
    "ogl": "^1.0.11",
    "ollama": "^0.6.3",
    "pg": "^8.16.3",
    "phaser": "^3.90.0",
    "postprocessing": "^6.38.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.4.0",
    "react-leaflet": "^4.2.1",
    "react-map-gl": "^8.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.2",
    "tailwind-merge": "^3.4.0",
    "three": "^0.182.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.23",
    "esbuild": "^0.27.0",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "vite": "^7.3.0"
  }
}