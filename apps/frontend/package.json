{
  "name": "@truegle/frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ],
  "scripts": {
    "dev": "vite",
    "check:ads": "node scripts/check-ads.mjs",
    "build": "npm run check:ads && node scripts/build.mjs",
    "vercel-build": "npm run check:ads && node scripts/build.mjs",
    "lint": "eslint .",
    "lint:error": "eslint . --quiet",
    "preview": "vite preview",
    "trail": "esbuild dev/trail.entry.js --bundle --format=esm --outfile=dev/.build/trail.js --servedir=dev --serve=5174",
    "trail:test": "esbuild scripts/verify-trail.mjs --bundle --format=esm --platform=node --outfile=dev/.build/trail-test.mjs --log-level=error && node dev/.build/trail-test.mjs",
    "trailpage:test": "node scripts/verify-trail-page.mjs",
    "trail:browser": "node scripts/verify-trail-browser.mjs",
    "vault:browser": "node scripts/verify-vault-browser.mjs",
    "feedpage:test": "node scripts/verify-feed-page.mjs",
    "cameraview:test": "node scripts/verify-camera-view.mjs",
    "mapui:test": "node scripts/verify-map-ui.mjs",
    "chatmap:test": "node scripts/verify-chat-map.mjs",
    "reddit:test": "node scripts/verify-player-reddit.mjs",
    "localquery:test": "esbuild scripts/verify-local-query.mjs --bundle --format=esm --platform=node --alias:axios=./scripts/stubs/axios.mjs --define:import.meta.env='{\"DEV\":false}' --external:react --outfile=dev/.build/localquery-test.mjs --log-level=error && node dev/.build/localquery-test.mjs",
    "embeddable:test": "node scripts/verify-embeddable.mjs",
    "urlquery:test": "node scripts/verify-url-query.mjs",
    "linkpack:test": "node scripts/verify-link-pack.mjs",
    "spelling:test": "node scripts/verify-spelling.mjs",
    "noselect:test": "node scripts/verify-no-select.mjs",
    "titles:test": "esbuild scripts/verify-resolve-titles.mjs --bundle --format=esm --platform=node --define:import.meta.env='{\"VITE_BACKEND_URL\":\"http://localhost:3001\"}' --external:react --outfile=dev/.build/titles-test.mjs --log-level=error && node dev/.build/titles-test.mjs",
    "map:test": "esbuild scripts/verify-map-api.mjs --bundle --format=esm --platform=node --alias:axios=./scripts/stubs/axios.mjs --define:import.meta.env='{\"DEV\":false}' --outfile=dev/.build/map-test.mjs --log-level=error && node dev/.build/map-test.mjs",
    "vault:test": "esbuild scripts/verify-encyclopedia.mjs --bundle --format=esm --platform=node --loader:.md=text --outfile=dev/.build/vault-test.mjs --log-level=error && node dev/.build/vault-test.mjs",
    "player:test": "esbuild scripts/verify-player.mjs --bundle --format=esm --platform=node --outfile=dev/.build/player-test.mjs --external:esbuild --log-level=error && node dev/.build/player-test.mjs",
    "nav:test": "esbuild scripts/verify-navigation.mjs --bundle --format=esm --platform=node --alias:axios=./scripts/stubs/axios.mjs --define:import.meta.env='{\"DEV\":false}' --external:react --outfile=dev/.build/nav-test.mjs --log-level=error && node dev/.build/nav-test.mjs",
    "feed:test": "node scripts/verify-feed.mjs",
    "markdown:test": "node scripts/verify-markdown.mjs",
    "published:test": "node scripts/verify-published.mjs",
    "resultsort:test": "node scripts/verify-result-sort.mjs",
    "retention:test": "node scripts/verify-retention.mjs",
    "playlist:test": "node scripts/verify-playlist-import.mjs",
    "vaulttier:test": "node scripts/verify-vault-tier.mjs",
    "playerengine:test": "esbuild scripts/verify-player-engine.mjs --bundle --format=esm --platform=node --outfile=dev/.build/player-engine-test.mjs --external:react --external:esbuild --log-level=error && node dev/.build/player-engine-test.mjs",
    "autocomplete:test": "node scripts/verify-autocomplete.mjs",
    "autocompleteui:test": "node scripts/verify-autocomplete-ui.mjs",
    "overlayreveal:test": "esbuild scripts/verify-overlay-reveal.mjs --bundle --format=esm --platform=node --alias:react=./scripts/stubs/react.mjs --outfile=dev/.build/overlay-reveal-test.mjs --log-level=error && node dev/.build/overlay-reveal-test.mjs",
    "aierror:test": "node scripts/verify-ai-error.mjs",
    "lockedgestures:test": "esbuild scripts/verify-locked-gestures.mjs --bundle --format=esm --platform=node --alias:react=./scripts/stubs/react.mjs --outfile=dev/.build/locked-gestures-test.mjs --log-level=error && node dev/.build/locked-gestures-test.mjs"
  },
  "dependencies": {
    "@mapbox/mapbox-sdk": "^0.16.2",
    "@paypal/react-paypal-js": "^10.1.0",
    "@questlabs/react-sdk": "latest",
    "@react-three/drei": "^9.112.0",
    "@react-three/fiber": "^8.15.19",
    "@supabase/supabase-js": "^2.39.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@tomtom-international/web-sdk-services": "^6.25.0",
    "@turf/turf": "^7.3.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "clsx": "^2.1.1",
    "date-fns": "4.1.0",
    "dompurify": "^3.4.5",
    "echarts": "^5.5.0",
    "echarts-for-react": "^3.0.2",
    "framer-motion": "^11.18.2",
    "hls.js": "^1.7.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.562.0",
    "mapbox-gl": "^3.18.0",
    "maplibre-gl": "^5.24.0",
    "ogl": "^1.0.11",
    "ollama": "^0.6.3",
    "pg": "^8.16.3",
    "phaser": "^3.90.0",
    "postprocessing": "^6.38.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.4.0",
    "react-leaflet": "^4.2.1",
    "react-map-gl": "^8.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.4.0",
    "three": "^0.182.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.23",
    "esbuild": "^0.27.0",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "vite": "^7.3.0"
  }
}
